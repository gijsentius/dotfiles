if [ -n "$INTELLIJ_ENVIRONMENT_READER" ]; then
  return
fi

# Attach to (or create) the "workspace" tmux session
if [ -z "$TMUX" ] && command -v tmux >/dev/null; then
  tmux new-session -A -s workspace
fi

# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   mkdir -p ${XDG_DATA_HOME:-${HOME}/.cache/zinit/completions}
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in zsh plugins (zsh-completions before compinit, fzf-tab right after,
# syntax highlighting last)
zinit light zsh-users/zsh-completions

autoload -Uz compinit
compinit

zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-autosuggestions

# Add in snippets
zinit snippet OMZP::git
zinit snippet OMZP::genpass
zinit snippet OMZP::git-auto-fetch
zinit snippet OMZP::gitignore
zinit snippet OMZP::helm
zinit snippet OMZP::sudo
zinit snippet OMZP::argocd
zinit snippet OMZP::chezmoi

# Must be loaded after all other widgets
zinit light zsh-users/zsh-syntax-highlighting

# Homebrew (starship, fzf, ... live here)
{{ if eq .chezmoi.os "linux" -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ else if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ end }}
# Init starship
eval "$(starship init zsh)"

# History
HISTSIZE=12000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
export PATH=~/.bin/:$PATH
export PATH=~/.local/bin/:$PATH

export SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt

# Source all zsh stuff managed by chezmoi (aliases, completions, ...)
for f in ~/.zsh/*(.N); do source $f; done

# Machine-specific config that isn't in chezmoi (e.g. work settings, secrets).
# Drop any *.zsh file in ~/.zsh/local/; loaded last so it can override the above.
for f in ~/.zsh/local/*.zsh(.N); do source $f; done
[ -f ~/.zsh_overrides ] && source ~/.zsh_overrides
unset f
